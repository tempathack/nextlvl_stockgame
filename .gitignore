# Environment files (contain secrets)
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.eggs/
*.egg-info/
dist/
build/
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
frontend-react/dist/
backend/dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Logs
*.log
logs/

# Database
*.db
*.sqlite3

# Kubernetes local
*.kubeconfig

# Temporary files
tmp/
temp/
*.tmp
.k8s-generated/

# Secrets (never commit)
**/secrets.yaml.local
*.pem
*.key
